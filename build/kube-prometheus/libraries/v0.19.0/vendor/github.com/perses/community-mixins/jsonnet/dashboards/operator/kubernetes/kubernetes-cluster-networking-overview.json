{
  "kind": "PersesDashboard",
  "apiVersion": "perses.dev/v1alpha2",
  "metadata": {
    "name": "kubernetes-cluster-networking-overview",
    "namespace": "perses-dev",
    "labels": {
      "app.kubernetes.io/component": "dashboard",
      "app.kubernetes.io/instance": "kubernetes-cluster-networking-overview",
      "app.kubernetes.io/name": "perses-dashboard",
      "app.kubernetes.io/part-of": "perses-operator"
    }
  },
  "spec": {
    "config": {
      "display": {
        "name": "Kubernetes / Networking / Cluster"
      },
      "variables": [
        {
          "kind": "ListVariable",
          "spec": {
            "display": {
              "name": "cluster",
              "hidden": false
            },
            "allowAllValue": false,
            "allowMultiple": false,
            "plugin": {
              "kind": "PrometheusLabelValuesVariable",
              "spec": {
                "datasource": {
                  "kind": "PrometheusDatasource",
                  "name": "prometheus-datasource"
                },
                "labelName": "cluster",
                "matchers": [
                  "up{job=\"kubelet\"}"
                ]
              }
            },
            "name": "cluster"
          }
        }
      ],
      "panels": {
        "0_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Current Rate of Bytes Received",
              "description": "Shows the rate of bytes received by namespace in a cluster."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "list",
                  "position": "bottom",
                  "size": "small"
                },
                "visual": {
                  "areaOpacity": 0.75,
                  "display": "line",
                  "lineWidth": 0.25,
                  "palette": {
                    "mode": "auto"
                  }
                },
                "yAxis": {
                  "format": {
                    "unit": "bytes/sec"
                  }
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "prometheus-datasource"
                      },
                      "query": "sum by (namespace) (\n    rate(container_network_receive_bytes_total{cluster=\"$cluster\",namespace!=\"\"}[$__rate_interval])\n  * on (cluster, namespace, pod) group_left ()\n    topk by (cluster, namespace, pod) (\n      1,\n      max by (cluster, namespace, pod) (kube_pod_info{host_network=\"false\"})\n    )\n)",
                      "seriesNameFormat": "{{namespace}}"
                    }
                  }
                }
              }
            ]
          }
        },
        "0_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Current Rate of Bytes Transmitted",
              "description": "Shows the rate of bytes transmitted by namespace in a cluster."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "list",
                  "position": "bottom",
                  "size": "small"
                },
                "visual": {
                  "areaOpacity": 0.75,
                  "display": "line",
                  "lineWidth": 0.25,
                  "palette": {
                    "mode": "auto"
                  }
                },
                "yAxis": {
                  "format": {
                    "unit": "bytes/sec"
                  }
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "prometheus-datasource"
                      },
                      "query": "sum by (namespace) (\n    rate(container_network_transmit_bytes_total{cluster=\"$cluster\",namespace!=\"\"}[$__rate_interval])\n  * on (cluster, namespace, pod) group_left ()\n    topk by (cluster, namespace, pod) (\n      1,\n      max by (cluster, namespace, pod) (kube_pod_info{host_network=\"false\"})\n    )\n)",
                      "seriesNameFormat": "{{namespace}}"
                    }
                  }
                }
              }
            ]
          }
        },
        "1_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Current Status",
              "description": "Shows the current network status of the cluster by namespace."
            },
            "plugin": {
              "kind": "Table",
              "spec": {
                "columnSettings": [
                  {
                    "align": "left",
                    "header": "Namespace",
                    "name": "namespace"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "bytes/sec"
                    },
                    "header": "Rx Bytes",
                    "name": "value #1"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "bytes/sec"
                    },
                    "header": "Tx Bytes",
                    "name": "value #2"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "bytes/sec"
                    },
                    "header": "Rx Bytes (Avg)",
                    "name": "value #3"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "bytes/sec"
                    },
                    "header": "Tx Bytes (Avg)",
                    "name": "value #4"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "packets/sec"
                    },
                    "header": "Rx Packets",
                    "name": "value #5"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "packets/sec"
                    },
                    "header": "Tx Packets",
                    "name": "value #6"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "packets/sec"
                    },
                    "header": "Rx Packets Dropped",
                    "name": "value #7"
                  },
                  {
                    "align": "right",
                    "format": {
                      "unit": "packets/sec"
                    },
                    "header": "Tx Packets Dropped",
                    "name": "value #8"
                  },
                  {
                    "hide": true,
                    "name": "timestamp"
                  }
                ],
                "transforms": [
                  {
                    "kind": "MergeSeries",
                    "spec": {}
                  }
                ]
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "prometheus-datasource"
                      },
                      "query": "sum by (namespace) (\n    rate(container_network_receive_bytes_total{cluster=\"$cluster\",namespace!=\"\"}[$__rate_interval])\n  * on (cluster, namespace, pod) group_left ()\n    topk by (cluster, namespace, pod) (\n      1,\n      max by (cluster, namespace, pod) (kube_pod_info{host_network=\"false\"})\n    )\n)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "prometheus-datasource"
                      },
                      "query": "sum by (namespace) (\n    rate(container_network_transmit_bytes_total{cluster=\"$cluster\",namespace!=\"\"}[$__rate_interval])\n  * on (cluster, namespace, pod) group_left ()\n    topk by (cluster, namespace, pod) (\n      1,\n      max by (cluster, namespace, pod) (kube_pod_info{host_network=\"false\"})\n    )\n)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "prometheus-datasource"
                      },
                      "query": "avg by (namespace) (\n    rate(container_network_receive_bytes_total{cluster=\"$cluster\",namespace!=\"\"}[$__rate_interval])\n  * on (cluster, namespace, pod) group_left ()\n    topk by (cluster, namespace, pod) (\n      1,\n      max by (cluster, namespace, pod) (kube_pod_info{host_network=\"false\"})\n    )\n)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "prometheus-datasource"
                      },
                      "query": "avg by (namespace) (\n    rate(container_network_transmit_bytes_total{cluster=\"$cluster\",namespace!=\"\"}[$__rate_interval])\n  * on (cluster, namespace, pod) group_left ()\n    topk by (cluster, namespace, pod) (\n      1,\n      max by (cluster, namespace, pod) (kube_pod_info{host_network=\"false\"})\n    )\n)"
                    }
