                      "query": "sort_desc(\n  sum by (pod) (\n      rate(\n        container_network_transmit_bytes_total{cluster=\"$cluster\",job=\"cadvisor\",namespace=~\"$namespace\"}[$__rate_interval]\n      )\n    * on (namespace, pod) group_left (workload, workload_type)\n      namespace_workload_pod:kube_pod_owner:relabel{cluster=\"$cluster\",namespace=~\"$namespace\",workload=~\"$workload\",workload_type=~\"$type\"}\n  )\n)",
                      "seriesNameFormat": "{{pod}}"
                    }
                  }
                }
              }
            ]
          }
        },
