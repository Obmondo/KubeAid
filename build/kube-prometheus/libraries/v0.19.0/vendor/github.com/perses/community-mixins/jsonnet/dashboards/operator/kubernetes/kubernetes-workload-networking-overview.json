{
  "kind": "PersesDashboard",
  "apiVersion": "perses.dev/v1alpha2",
  "metadata": {
    "name": "kubernetes-workload-networking-overview",
    "namespace": "perses-dev",
    "labels": {
      "app.kubernetes.io/component": "dashboard",
      "app.kubernetes.io/instance": "kubernetes-workload-networking-overview",
      "app.kubernetes.io/name": "perses-dashboard",
      "app.kubernetes.io/part-of": "perses-operator"
    }
  },
  "spec": {
    "config": {
      "display": {
        "name": "Kubernetes / Networking / Workload"
      },
      "variables": [
        {
          "kind": "ListVariable",
          "spec": {
            "display": {
              "name": "cluster",
              "hidden": false
            },
            "allowAllValue": false,
            "allowMultiple": false,
            "plugin": {
              "kind": "PrometheusLabelValuesVariable",
              "spec": {
                "datasource": {
                  "kind": "PrometheusDatasource",
                  "name": "prometheus-datasource"
                },
                "labelName": "cluster",
                "matchers": [
                  "up{job=\"kubelet\"}"
                ]
              }
            },
            "name": "cluster"
          }
        },
        {
          "kind": "ListVariable",
          "spec": {
            "display": {
              "name": "namespace",
              "hidden": false
            },
            "allowAllValue": false,
            "allowMultiple": false,
            "plugin": {
              "kind": "PrometheusLabelValuesVariable",
              "spec": {
                "datasource": {
                  "kind": "PrometheusDatasource",
                  "name": "prometheus-datasource"
                },
                "labelName": "namespace",
                "matchers": [
                  "container_network_receive_packets_total{cluster=\"$cluster\"}"
                ]
              }
            },
            "name": "namespace"
          }
        },
        {
          "kind": "ListVariable",
          "spec": {
            "display": {
              "name": "workload_type",
              "hidden": false
            },
            "allowAllValue": false,
            "allowMultiple": false,
            "plugin": {
              "kind": "PrometheusLabelValuesVariable",
              "spec": {
                "datasource": {
                  "kind": "PrometheusDatasource",
                  "name": "prometheus-datasource"
                },
                "labelName": "workload_type",
                "matchers": [
                  "namespace_workload_pod:kube_pod_owner:relabel{cluster=\"$cluster\",namespace=\"$namespace\"}"
                ]
              }
            },
            "name": "type"
          }
        },
        {
          "kind": "ListVariable",
          "spec": {
            "display": {
              "name": "workload",
              "hidden": false
            },
            "allowAllValue": false,
            "allowMultiple": false,
            "plugin": {
              "kind": "PrometheusLabelValuesVariable",
              "spec": {
                "datasource": {
                  "kind": "PrometheusDatasource",
                  "name": "prometheus-datasource"
                },
                "labelName": "workload",
                "matchers": [
                  "namespace_workload_pod:kube_pod_owner:relabel{cluster=\"$cluster\",namespace=\"$namespace\",workload_type=\"$type\"}"
                ]
              }
            },
            "name": "workload"
          }
        }
      ],
      "panels": {
        "0_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Current Rate of Bytes Received",
              "description": "Shows the rate of bytes received by top pods in a workload in a cluster."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "list",
                  "position": "bottom",
                  "size": "small"
                },
                "visual": {
                  "areaOpacity": 0.75,
                  "display": "line",
                  "lineWidth": 0.25,
                  "palette": {
                    "mode": "auto"
                  }
                },
                "yAxis": {
                  "format": {
                    "unit": "bytes/sec"
                  }
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "prometheus-datasource"
                      },
                      "query": "sort_desc(\n  sum by (pod) (\n      rate(\n        container_network_receive_bytes_total{cluster=\"$cluster\",job=\"cadvisor\",namespace=~\"$namespace\"}[$__rate_interval]\n      )\n    * on (namespace, pod) group_left (workload, workload_type)\n      namespace_workload_pod:kube_pod_owner:relabel{cluster=\"$cluster\",namespace=~\"$namespace\",workload=~\"$workload\",workload_type=~\"$type\"}\n  )\n)",
                      "seriesNameFormat": "{{pod}}"
                    }
                  }
                }
              }
            ]
          }
        },
        "0_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Current Rate of Bytes Transmitted",
