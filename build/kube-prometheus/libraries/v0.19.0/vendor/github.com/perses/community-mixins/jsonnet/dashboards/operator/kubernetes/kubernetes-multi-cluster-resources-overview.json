                  },
                  {
                    "align": "right",
                    "format": {
                      "decimalPlaces": 4,
                      "unit": "decimal"
                    },
                    "header": "CPU Usage",
                    "name": "value #1"
                  },
                  {
                    "align": "right",
                    "format": {
                      "decimalPlaces": 4,
                      "unit": "decimal"
                    },
                    "header": "CPU Requests",
                    "name": "value #2"
                  },
                  {
                    "align": "right",
                    "format": {
                      "decimalPlaces": 4,
                      "unit": "percent-decimal"
                    },
                    "header": "CPU Requests %",
                    "name": "value #3"
