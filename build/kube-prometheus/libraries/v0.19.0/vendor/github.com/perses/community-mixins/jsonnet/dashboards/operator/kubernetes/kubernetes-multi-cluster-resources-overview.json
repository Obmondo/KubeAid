            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "list",
                  "position": "bottom",
                  "size": "small"
                },
                "visual": {
                  "areaOpacity": 1,
                  "display": "line",
                  "lineWidth": 0.25,
                  "palette": {
                    "mode": "auto"
                  }
                },
                "yAxis": {
                  "format": {
                    "unit": "decimal"
