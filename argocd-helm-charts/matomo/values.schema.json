{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "archive": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "schedule": {
          "type": "string"
        }
      }
    },
    "extraHosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "host": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "className": {
          "type": "string"
        },
        "tls": {
          "type": "boolean"
        }
      }
    },
    "mariadb": {
      "type": "object",
      "properties": {
        "database": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "imagePullPolicy": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "logicalbackup": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "failedJobsHistoryLimit": {
              "type": "integer"
            }
          }
        },
        "passwordSecretKeyRef": {
          "type": "object",
          "properties": {
            "generate": {
              "type": "boolean"
            },
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "rootPasswordSecretKeyRef": {
          "type": "object",
          "properties": {
            "generate": {
              "type": "boolean"
            },
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "resizeInUseVolumes": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            },
            "waitForVolumeResize": {
              "type": "boolean"
            }
          }
        },
        "username": {
          "type": "string"
        }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "keycloakUrl": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany"
          ]
        },
        "size": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ]
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
