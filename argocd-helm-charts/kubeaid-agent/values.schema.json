{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "appConfig": {
      "description": "KubeAid Agent config file contents.",
      "type": "object",
      "properties": {
        "obmondoAPI": {
          "type": "object",
          "properties": {
            "tls": {
              "type": "object",
              "properties": {
                "certFile": {
                  "type": "string"
                },
                "keyFile": {
                  "type": "string"
                }
              }
            }
          }
        },
        "server": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer"
            }
          }
        },
        "kubeaidUpdate": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "When true, the service-window ArgoCD sync cron job is scheduled. Default false (opt-in per cluster).",
              "type": "boolean"
            },
            "checkInterval": {
              "description": "How often the agent polls Obmondo API for an active KubeAid update service window.",
              "type": "string"
            }
          }
        },
        "nodeUpdate": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "When true, the agent updates the nodes' OS packages (linuxaid-cli, one node at a time) while the service window is open. It never drains or reboots.",
              "type": "boolean"
            },
            "checkInterval": {
              "description": "How often the agent looks for an open service window.",
              "type": "string"
            },
            "nodeSelector": {
              "description": "Extra label selector for the nodes to update; always ANDed with kubernetes.io/os=linux.",
              "type": "string"
            },
            "capiMachinesOnly": {
              "description": "Only update nodes Cluster API provisioned (not MachinePool nodes). Set false on clusters without Cluster API.",
              "type": "boolean"
            },
            "jobImage": {
              "description": "linuxaid-cli image the update Jobs run (must contain node-update.sh). Required when enabled.",
              "type": "string"
            },
            "jobServiceAccount": {
              "description": "Service account of the update Job pods; created by the chart without permissions or token.",
              "type": "string"
            },
            "updateTimeout": {
              "description": "Deadline of one node's update Job.",
              "type": "string"
            }
          }
        },
        "securityPosture": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "When true, the agent polls the security exporter and forwards its snapshots to Obmondo API. Set false on clusters that must not ship vulnerability detail off-site.",
              "type": "boolean"
            },
            "exporterURL": {
              "description": "In-cluster URL of the security exporter. A bare Service name resolves within the agent's own namespace.",
              "type": "string"
            },
            "pollInterval": {
              "description": "How often the agent polls the exporter. The submit is skipped when collectedAt has not advanced.",
              "type": "string"
            },
            "windowCheckInterval": {
              "description": "How often the agent looks for a service-window edge, to capture a before/after pair around maintenance.",
              "type": "string"
            }
          }
        }
      }
    },
    "configMap": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "affinity": {
          "type": "object"
        },
        "env": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object",
          "properties": {
            "fsGroup": {
              "type": "integer"
            },
            "runAsNonRoot": {
              "type": "boolean"
            },
            "seccompProfile": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                }
              }
            }
          }
        },
        "probes": {
          "type": "object",
          "properties": {
            "liveness": {
              "type": "object",
              "properties": {
                "failureThreshold": {
                  "type": "integer"
                },
                "httpGet": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "port": {
                      "type": "string"
                    }
                  }
                },
                "initialDelaySeconds": {
                  "type": "integer"
                },
                "periodSeconds": {
                  "type": "integer"
                },
                "successThreshold": {
                  "type": "integer"
                },
                "timeoutSeconds": {
                  "type": "integer"
                }
              }
            },
            "readiness": {
              "type": "object",
              "properties": {
                "failureThreshold": {
                  "type": "integer"
                },
                "httpGet": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "port": {
                      "type": "string"
                    }
                  }
                },
                "initialDelaySeconds": {
                  "type": "integer"
                },
                "periodSeconds": {
                  "type": "integer"
                },
                "successThreshold": {
                  "type": "integer"
                },
                "timeoutSeconds": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "replicas": {
          "type": "integer"
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "allowPrivilegeEscalation": {
              "type": "boolean"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "privileged": {
              "type": "boolean"
            },
            "runAsGroup": {
              "type": "integer"
            },
            "runAsNonRoot": {
              "type": "boolean"
            },
            "runAsUser": {
              "type": "integer"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer"
        },
        "tolerations": {
          "type": "array"
        }
      }
    },
    "extraSecretReaderNamespaces": {
      "description": "Extra namespaces where the agent's ServiceAccount may read secrets. A Role + RoleBinding is created in each.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fullnameOverride": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "obmondoAPITLSSecretName": {
      "description": "Kubernetes Secret name containing the TLS certificate key-pair, used to communicate with Obmondo API.",
      "type": "string"
    },
    "service": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "scrapeTimeout": {
          "type": "string"
        }
      }
    }
  }
}
