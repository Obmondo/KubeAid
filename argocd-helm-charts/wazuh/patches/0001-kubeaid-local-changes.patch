+++ b/templates/manager/master/poddisruptionbudget.yaml
@@ -0,0 +1,29 @@
+{{- /*
+  KubeAid patch. The master is a single pod that every worker and every agent
+  enrolment depends on, and its /var/ossec/etc holds client.keys. With one
+  replica, minAvailable: 1 refuses voluntary eviction outright rather than
+  delaying it: draining that node becomes a decision someone makes
+  (kubectl drain --disable-eviction), not something unattended maintenance does.
+  Off by default for exactly that reason.
+*/}}
+{{- if .Values.wazuh.master.enabled }}
+{{- if .Values.wazuh.master.pdb.enabled }}
+kind: PodDisruptionBudget
+apiVersion: policy/v1
+metadata:
+  name: {{ include "wazuh.fullname" . }}-manager-master
+  namespace: {{ .Release.Namespace }}
+spec:
+  selector:
+    matchLabels:
+      app: {{ include "wazuh.fullname" . }}-manager
+      node-type: master
+  {{- if .Values.wazuh.master.pdb.minAvailable }}
+  minAvailable: {{ .Values.wazuh.master.pdb.minAvailable }}
+  {{- else }}
+  {{- with .Values.wazuh.master.pdb.maxUnavailable }}
+  maxUnavailable: {{ . }}
+  {{- end }}
+  {{- end }}
+{{- end }}
+{{- end }}
