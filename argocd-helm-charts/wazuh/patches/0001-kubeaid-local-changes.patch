+done
+routing_args=(--set wazuh.filebeat.indexRouting.enabled=true --set wazuh.filebeat.indexRouting.labelKey=unit
+              --set-string 'wazuh.filebeat.indexRouting.valuePattern=^[0-9]{3}$'
