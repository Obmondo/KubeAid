{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["domain", "keycloak", "operators", "tenants", "tenantGroupPrefix", "tenantLabelKey"],
  "properties": {
    "domain": {"type": "string", "minLength": 1},
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wazuh": {"type": "string"},
        "iris": {"type": "string"},
        "misp": {"type": "string"},
        "velociraptor": {"type": "string"}
      }
    },
    "keycloak": {
      "type": "object",
      "required": ["url", "realm", "adminSecretRef"],
      "additionalProperties": false,
      "properties": {
        "adminUsername": {"type": "string"},
        "caFile": {"type": "string"},
        "insecureSkipVerify": {"type": "boolean"},
        "bruteForceProtected": {"type": "boolean"},
        "otpPolicy": {"type": "object"},
        "requireTOTP": {"type": "boolean"},
        "mfaFlow": {"type": "object"},
        "url": {"type": "string", "pattern": "^https?://"},
        "realm": {"type": "string", "minLength": 1},
        "adminSecretRef": {
          "type": "object",
          "required": ["namespace", "name", "key"],
          "properties": {
            "namespace": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "clients": {"type": "array", "items": {"type": "object"}}
      }
    },
    "operators": {
      "type": "object",
      "required": ["adminRole", "analystRole"],
      "properties": {
        "adminRole": {"type": "string", "minLength": 1},
        "analystRole": {"type": "string", "minLength": 1},
        "analystGroup": {"type": "string"}
      }
    },
    "tenants": {
      "description": "One entry per tenant. Uniqueness of code and name is checked by the templates.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": {
            "description": "Lower-case letters and digits, no dashes, so the alerts index patterns of two tenants never overlap.",
            "type": "string",
            "pattern": "^[a-z0-9]{1,32}$"
          },
          "name": {"type": "string", "minLength": 1},
          "retentionDays": {"type": "integer", "minimum": 1},
          "idp": {"type": "object"}
        }
      }
    },
    "tenantGroupPrefix": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "tenantLabelKey": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "defaultRetentionDays": {"type": "integer", "minimum": 1},
    "reconciler": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "dryRun": {"type": "boolean"},
        "postSync": {"type": "boolean"}
      }
    }
  }
}
